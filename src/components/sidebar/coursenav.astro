---
import { Icon } from 'astro-icon/components';
const{ id, json } = Astro.props;
console.log( json );
---
<div class="flex flex-col flex-1 overflow-y-auto">
    <nav class="flex-1 px-2 py-4  bg-rbb-light-gray)] dark:bg-[var(--rbb-gray-950)]">
        <div class="flex gap-2 items-center">
            <Icon name="fa6-solid:chalkboard-user" class="h-6 w-6" />
            <span class="text-lg">{id}</span>
        </div>
        { json && json.map( category => {
            let isOpen = category.pages?.some( i => i.slug === Astro.url.pathname.replace("/", ""));
            const escapedCategoryName = category.name.replace(/[^a-zA-Z ]/g, "");

            return <div class="mb-2 relative group">
                <input type="checkbox" id={`${escapedCategoryName}-toggle`} class="hidden peer" { ...(isOpen ? { checked:true} : {}) } >
            
                <label for={`${escapedCategoryName}-toggle`}
                    class="flex items-center px-12 py-2 mt-2 text-gray-100 hover:bg-rbb-gray-800 cursor-pointer w-full group-hover:text-garnet-500">
                    {category.name}
                </label>
                
                <Icon name="fa6-solid:chevron-right" class="h-4 w-4 ml-auto transition-transform peer-checked:rotate-90 absolute right-4 top-3 transform #dis--translate-y-1/2 text-white" />
                
                <div class="hidden peer-checked:flex flex-col bg-rbb-gray-800 text-gray-200 mt-1 transition-all duration-300">
                    { category.pages.map( page =>{
                        const url = (page.url === 'index' || page.url === 'index.html') ? './' : page.url?.substring(0, page.url.indexOf( "." ));
                        return <a href={page.externalLink? page.url : url} target={page.externalLink ? "_blank": "_self" } class="flex px-4 py-2 hover:bg-rbb-gray-600">
                            <span>{page.name}</span>
                            { page.externalLink && <Icon name="fa6-solid:up-right-from-square" class="h-4 w-4 ml-auto right-4" />}
                        </a>
                    })}
                </div>
            </div>
        })}
    </nav>
</div>