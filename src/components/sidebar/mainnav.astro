---
import { Icon } from 'astro-icon/components';
import navData from '../../../public/content/data/nav.json';
---
<div class="flex flex-col flex-1 overflow-y-auto">
    <nav class="flex-1 px-2 py-4  bg-rbb-light-gray)] dark:bg-[var(--rbb-gray-950)]">

        { navData && navData.map( category => {
            let isOpen = category.items?.some( i => i.slug === Astro.url.pathname.replace("/", ""));
            const escapedCategoryName = category.category.replace(/[^a-zA-Z ]/g, "");

            return <div class="mb-2 relative group">
                <input type="checkbox" id={`${escapedCategoryName}-toggle`} class="hidden peer" { ...(isOpen ? { checked:true} : {}) } >
            
                <label for={`${escapedCategoryName}-toggle`}
                    class="flex items-center px-12 py-2 mt-2 text-gray-100 hover:bg-rbb-gray-800 cursor-pointer w-full group-hover:text-garnet-500">
                    {category.category}
                </label>
                <Icon name={category.icon} class="absolute top-2 left-4 text-white group-hover:text-garnet-500 h-6 w-6 mr-2" />
                {/* <Icon name="fa6-solid:microscope" class="absolute top-2 left-4 text-white hidden group-hover:block peer-checked:block h-6 w-6 mr-2" /> */}
                
                <!-- Arrow Icon -->
                <Icon name="fa6-solid:chevron-right" class="h-4 w-4 ml-auto transition-transform peer-checked:rotate-90 absolute right-4 top-3 transform #dis--translate-y-1/2 text-white" />
                
            
                <div class="hidden peer-checked:flex flex-col bg-rbb-gray-800 text-gray-200 mt-1 transition-all duration-300">
                    { category.items.map( item =>{
                        return <a href={item.slug} target={item.external ? "_blank": "_self" } class="flex px-4 py-2 hover:bg-rbb-gray-600">
                            <span>{item.name}</span>
                            { item.external && <Icon name="fa6-solid:up-right-from-square" class="h-4 w-4 ml-auto right-4" />}
                            
                        </a>
                    })}
                    
                </div>
            </div>
        })}



        <!-- Dashboard
        <a href="/" class="flex items-center px-4 py-2 text-gray-100 hover:bg-gray-700 group">
            <Icon name="fa6-solid:house" class="text-gray-200 hover:dark:text-garnet-700 h-6 w-6 mr-2 group-hover:transform" />
            Home
        </a> -->

        <!-- Login
        <a href="#" class="flex items-center px-4 py-2 text-gray-100 hover:bg-gray-700 group">
            <Icon name="fa6-solid:microchip" class="group-hover:hidden h-6 w-6 mr-2"/>
            <Icon name="fa6-solid:microscope" class="hidden group-hover:block h-6 w-6 mr-2"/>
            Login
        </a> -->
        
    </nav>
</div>