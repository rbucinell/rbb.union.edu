---
import SidebarToggle from '@/components/sidebar/sidebartoggle.astro';
import BreadCrumbSeperator from '@/components/breadcrumbs/seperator.astro';
import { Icon } from 'astro-icon/components';
const { slug = "#", category, name, courseId, courseName } = Astro.props;
---
<header class="bg-gray-100 border-b h-16 border-garnet dark:bg-gray-100 dark:text-gray-800 navbar sticky top-0 z-10">
    <div class="flex px-4 items-center justify-start h-16  w-full">
        <SidebarToggle/>
        <div class="flex flex-col">
            <h1 class="text-2xl font-bold">{name}</h1>
            <div id="breadcrumbs" aria-label="breadcrumb" class="hidden md:flex w-full">
                <div class="flex gap-2 items-center h-8">
                    <Icon name="fa6-solid:house" class='my-auto h-4'/>
                    <BreadCrumbSeperator/>
                    {courseId &&
                        <a rel="noopener noreferrer" href="/courselisting" class="flex items-center px-1 text-garnet">Courses</a>
                        <BreadCrumbSeperator/>
                        <a rel="noopener noreferrer" href={`/courses/${courseId}/`} class="flex items-center px-1 capitalize text-garnet">{courseId}</a>
                        <BreadCrumbSeperator/>
                    }
                    <a rel="noopener noreferrer" href="#" class="flex items-center px-1 capitalize hover:underline  cursor-default">{category}</a>
                    <BreadCrumbSeperator/>
                    <a rel="noopener noreferrer" href={slug} class="flex items-center px-1 capitalize text-garnet">{name}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>