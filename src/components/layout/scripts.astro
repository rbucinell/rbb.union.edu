<script defer is:inline define:vars={{ name }}>
    (async()=> {

        let contentPath = window.location.href.substring( window.location.href.lastIndexOf('/') +1);
        console.log( 'contentPath',contentPath)
        contentPath = contentPath.endsWith('.html') ? contentPath : `${contentPath}.html`
        let content = '';
        try{
            content = await fetch( `/content/${contentPath.toLowerCase()}`);
        }catch( e ){
            content = await fetch( `/content/data/404.html`);
        }
        const content_body = await content.text();
        document.querySelector('#dadcontent').innerHTML = content_body;
        let updateDate = new Date(content.headers.get('Last-Modified')).toDateString();
        document.querySelector('.updated').innerText = `Updated: ${updateDate}`;
    })();
</script>