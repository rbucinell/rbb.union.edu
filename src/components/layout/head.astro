---
const { name, description} = Astro.props;
const metaDescription = description ?? "Ronald Bucinell's Professional Website";
---
<head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Ryan Bucinell">
    <meta name="viewport" content="width=device-width" />
    <meta name="keywords" content="factulty, professor, profile, ronlad bucinell, union, union college, mechanical, engineering, Course Links">

    <meta property="og:site_name" content="rbb.union.edu">
    <meta property="og:title" content="Ronald B. Bucinell Ph.D., P.E">
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="website">
    <meta property="og:image" content="/img/portrait.jpg">
    <meta property="og:image:alt" content="Portrait of Ronald Bucinell">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Ronald B. Bucinell Ph.D., P.E">
    <meta name="twitter:description" content={metaDescription}>
    <meta name="twitter:image" content="/img/portrait.jpg">
    <meta name="twitter:image:alt" content="Ronald's Portrait">

    <link rel="shortcut icon" href="/img/icons/favicon.ico">
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{name} | Ronald Bucinell</title>
</head>