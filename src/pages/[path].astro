---
import type { GetStaticPaths } from "astro";
import Layout from "../components/layout/layout.astro";
import nav from '../../public/content/data/nav.json';

export const getStaticPaths = (() => {
    //console.log( nav );
    return nav.map( cat => cat.items.filter( _ => !_.external).map( c => {
        let path = c.path.startsWith('/') ? c.path.slice(1) : c.path;
        if( path === '') path = 'index'
        //console.log( path, cat.category, c.name)
        return { 
            params: { path }, 
            props:{ menu: cat.category, name: c.name, href: path } 
        }
    })).flat();
}) satisfies GetStaticPaths;

const { menu, name, href } = Astro.props;
---
<Layout name={name} menu={menu} href={href} />