---
import CourseLayout from '@/layouts/courselayout.astro';
import type { GetStaticPaths } from "astro";
import { undefined } from 'astro:schema';

export const getStaticPaths = ( () => {

    const courseManifests = Object.values(import.meta.glob('@public/courses/**/manifest.json', { eager: true }))
        .map( _ => JSON.parse(JSON.stringify(_)).default as CourseManifest );

    const filtered = courseManifests.map( (manifest) => {
        const { created, sections  } = manifest;
        const course:Course = { id:manifest.id, name:manifest.name };

        return sections.map( s => {
            return s.pages.filter( p => !p.externalLink).map( p => {
                
                const page:Page = {
                    name: p.name,
                    category: s.name,
                    path: (p.url === 'index' || p.url === 'index.html') ? null: p.url?.substring(0, p.url.indexOf( "." ))
                };

                const coursePage:CoursePage ={
                    course,
                    page,
                    created,
                    images: [],
                    slug: page.path ? `${course.id}/${page.path}` : course.id,
                    nav: sections
                };

                return coursePage;
            });
        }).flat();
    }).flat();

    return filtered.map( coursePage => {
        return { 
            params: { course: coursePage.slug },
            props: {...coursePage},
        } 
    });
}) satisfies GetStaticPaths;

const { course, page, created, images, slug, nav } = Astro.props;
---
<CourseLayout coursePage={Astro.props as CoursePage}/>